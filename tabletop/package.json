{
  "name": "tabletop",
  "private": true,
  "version": "0.9.0",
  "description": "Kibitz: learn and practise card, board and tile games. Offline web app packaged as an Android APK.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "lint:lessons": "tsx scripts/lesson-lint.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:property && npm run lint:lessons",
    "e2e": "npm run build && playwright test --trace off",
    "ladder": "tsx scripts/ladder.ts",
    "icons": "node scripts/icons.mjs",
    "apk": "node scripts/apk.mjs",
    "import:puzzles": "tsx scripts/import-lichess-puzzles.ts",
    "generate:brisca": "tsx scripts/generate-brisca-endgames.ts",
    "generate:dominoes": "tsx scripts/generate-dominoes-endgames.ts",
    "generate:holdem": "tsx scripts/generate-holdem-preflop.ts",
    "generate:holdem-spots": "tsx scripts/generate-holdem-spots.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/core": "8.6.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "chess.js": "1.4.0",
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1",
    "ts-fsrs": "6.0.1",
    "tsshogi": "2.3.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sabaki/go-board": "1.4.3",
    "@sabaki/sgf": "3.5.0",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "pokersolver": "2.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
